# Backend origin. The API lives at ${VITE_MAIN_DOMAIN}/api
VITE_MAIN_DOMAIN=http://localhost:5000

# Optional override if the API is not at ${VITE_MAIN_DOMAIN}/api
VITE_API_URL=http://localhost:5000/api

# Routing note (multi-tenant):
#   /r/<slug>/            kiosk for that restaurant
#   /r/<slug>/login       staff sign-in for that restaurant
#   /r/<slug>/admin/...   staff & admin panel
#   /platform/login       platform administrator console
